#include <windows.h>

// the app icon lives in the exe so the taskbar / Explorer pin keeps it
1 ICON "nPrompt.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     1,0,2,0
 PRODUCTVERSION  1,0,2,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          0x40004L
 FILETYPE        0x1L
 FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "glitzhXEC"
            VALUE "FileDescription",  "nPrompt - a dark prompt scratchpad"
            VALUE "FileVersion",      "1.0.2"
            VALUE "InternalName",     "nPrompt"
            VALUE "LegalCopyright",   "MIT Licence"
            VALUE "OriginalFilename", "nPrompt.exe"
            VALUE "ProductName",      "nPrompt"
            VALUE "ProductVersion",   "1.0.2"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
